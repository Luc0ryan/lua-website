# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are visible in the browser; everything else stays on the server.

# Canonical origin, no trailing slash. Required in production
# (Stripe return URLs, sitemap, metadata).
SITE_URL=http://localhost:3000

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only for scripts/*.mjs migrations (write-scoped token). Not used by the site.
SANITY_API_TOKEN=

# Stripe (donations)
STRIPE_SECRET_KEY=

# HubSpot (contact form + footer newsletter)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID=
NEXT_PUBLIC_HUBSPOT_NEWSLETTER_FORM_ID=

# Maps: Mapbox renders /map; the Google key powers the Studio location picker
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to 1 to expose /map/demo in production
MAP_DEMO=
