{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "Lua Collective design tokens — W3C Design Tokens format. Compatible with Token Studio (Figma) and Style Dictionary.",

  "primitive": {
    "$description": "Raw values. Never use these directly in components — reference semantic tokens instead.",
    "color": {
      "black":       { "$value": "#111111", "$type": "color" },
      "beige":       { "$value": "#F2EFEA", "$type": "color" },
      "beige-dark":  { "$value": "#E8E4DF", "$type": "color" },
      "pink":        { "$value": "#DC738F", "$type": "color" },
      "lua-pink":    { "$value": "#C91F6E", "$type": "color" },
      "gray":        { "$value": "#888888", "$type": "color" }
    },
    "font": {
      "heading": { "$value": "Archivo, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "DM Sans, sans-serif",  "$type": "fontFamily" }
    },
    "font-weight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "font-size": {
      "xs":  { "$value": "12px", "$type": "dimension" },
      "sm":  { "$value": "14px", "$type": "dimension" },
      "md":  { "$value": "16px", "$type": "dimension" },
      "lg":  { "$value": "18px", "$type": "dimension" },
      "xl":  { "$value": "20px", "$type": "dimension" },
      "2xl": { "$value": "24px", "$type": "dimension" },
      "4xl": { "$value": "36px", "$type": "dimension" },
      "5xl": { "$value": "48px", "$type": "dimension" },
      "6xl": { "$value": "60px", "$type": "dimension" }
    },
    "line-height": {
      "tight":   { "$value": 1.1,  "$type": "number" },
      "snug":    { "$value": 1.25, "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.625,"$type": "number" }
    },
    "letter-spacing": {
      "heading":  { "$value": "-0.02em", "$type": "dimension" },
      "normal":   { "$value": "0em",     "$type": "dimension" },
      "wide":     { "$value": "0.05em",  "$type": "dimension" },
      "widest":   { "$value": "0.1em",   "$type": "dimension" }
    },
    "spacing": {
      "1":   { "$value": "4px",   "$type": "dimension" },
      "2":   { "$value": "8px",   "$type": "dimension" },
      "3":   { "$value": "12px",  "$type": "dimension" },
      "4":   { "$value": "16px",  "$type": "dimension" },
      "5":   { "$value": "20px",  "$type": "dimension" },
      "6":   { "$value": "24px",  "$type": "dimension" },
      "8":   { "$value": "32px",  "$type": "dimension" },
      "10":  { "$value": "40px",  "$type": "dimension" },
      "12":  { "$value": "48px",  "$type": "dimension" },
      "16":  { "$value": "64px",  "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0px", "$type": "dimension" },
      "sm":   { "$value": "4px", "$type": "dimension" }
    }
  },

  "semantic": {
    "$description": "Named by intent. These are what designers and engineers agree on — 'what is this for?' Maps primitives to purpose.",
    "color": {
      "background":         { "$value": "{primitive.color.beige}",      "$type": "color", "$description": "Page and surface background" },
      "background-subtle":  { "$value": "{primitive.color.beige-dark}",  "$type": "color", "$description": "Footer, inset sections, form fields" },
      "foreground":         { "$value": "{primitive.color.black}",       "$type": "color", "$description": "Primary text and borders" },
      "foreground-muted":   { "$value": "{primitive.color.gray}",        "$type": "color", "$description": "Secondary text, labels, placeholders" },
      "accent":             { "$value": "{primitive.color.pink}",        "$type": "color", "$description": "Hover states, active indicators, highlights" },
      "accent-brand":       { "$value": "{primitive.color.lua-pink}",    "$type": "color", "$description": "Lua brand color — use sparingly" }
    },
    "typography": {
      "family-display": { "$value": "{primitive.font.heading}", "$type": "fontFamily", "$description": "Archivo — headings and display text" },
      "family-body":    { "$value": "{primitive.font.body}",    "$type": "fontFamily", "$description": "DM Sans — body copy and UI text" },
      "tracking-display": { "$value": "{primitive.letter-spacing.heading}", "$type": "dimension" },
      "tracking-ui":      { "$value": "{primitive.letter-spacing.widest}",  "$type": "dimension", "$description": "Uppercase labels, nav links" }
    },
    "spacing": {
      "gutter": {
        "$value": "clamp(24px, 4vw, 64px)",
        "$type": "dimension",
        "$description": "Horizontal page rhythm. The single layout spacing source of truth."
      }
    },
    "shadow": {
      "brutalist-sm": { "$value": "3px 3px 0px #111111", "$type": "shadow", "$description": "Neo-brutalist offset shadow on buttons and cards" },
      "brutalist-md": { "$value": "6px 6px 0px #2B2B2B", "$type": "shadow", "$description": "Larger brutalist shadow on hover" }
    },
    "motion": {
      "duration-fast":   { "$value": "150ms", "$type": "duration" },
      "duration-base":   { "$value": "300ms", "$type": "duration" },
      "duration-slow":   { "$value": "500ms", "$type": "duration" },
      "easing-out":      { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier" }
    }
  },

  "component": {
    "$description": "Token decisions scoped to specific components. References semantic tokens — never primitive directly.",
    "button": {
      "brutalist": {
        "background":       { "$value": "{semantic.color.background}",   "$type": "color" },
        "text":             { "$value": "{semantic.color.foreground}",   "$type": "color" },
        "border":           { "$value": "{semantic.color.foreground}",   "$type": "color" },
        "shadow":           { "$value": "{semantic.shadow.brutalist-sm}","$type": "shadow" },
        "shadow-hover":     { "$value": "none",                          "$type": "shadow" },
        "translate-hover":  { "$value": "3px",                           "$type": "dimension" }
      },
      "solid": {
        "background":       { "$value": "{semantic.color.foreground}",   "$type": "color" },
        "text":             { "$value": "{semantic.color.background}",   "$type": "color" },
        "border":           { "$value": "none",                          "$type": "shadow" }
      }
    },
    "badge": {
      "font-size":    { "$value": "{primitive.font-size.xs}", "$type": "dimension" },
      "font-weight":  { "$value": "{primitive.font-weight.semibold}", "$type": "fontWeight" },
      "tracking":     { "$value": "{primitive.letter-spacing.widest}", "$type": "dimension" }
    },
    "input": {
      "background":   { "$value": "{semantic.color.background-subtle}", "$type": "color" },
      "border":       { "$value": "{semantic.color.foreground}",        "$type": "color" },
      "border-opacity": { "$value": "0.2", "$type": "number" },
      "padding-x":    { "$value": "{primitive.spacing.4}",              "$type": "dimension" },
      "padding-y":    { "$value": "{primitive.spacing.3}",              "$type": "dimension" }
    }
  }
}
